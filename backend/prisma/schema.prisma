generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  grade     String
  createdAt DateTime @default(now())
}

model Course {
  id         Int      @id @default(autoincrement())
  title      String
  code       String   @unique
  instructor String
  createdAt  DateTime @default(now())
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String
  code      String    @unique
  faculties Faculty[]
  createdAt DateTime  @default(now())
}

model Faculty {
  id           Int        @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String     @unique
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())
}

// --- ADMISSIONS MODULE ---

enum RegisterStatus {
  DRAFT
  CONFIRMED
  GATHERING
  PROCESSING
  DONE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  ADMISSION_CONFIRM
  DONE
  REJECTED
  CANCELLED
}

model AdmissionRegister {
  id           Int              @id @default(autoincrement())
  name         String
  startDate    DateTime
  endDate      DateTime
  minCapacity  Int              @default(0)
  maxCapacity  Int
  targetCourse String
  status       RegisterStatus   @default(DRAFT)
  applications Application[]
  createdAt    DateTime         @default(now())
}

model Application {
  id                  Int               @id @default(autoincrement())
  applicationNumber   String            @unique
  firstName           String
  middleName          String?
  lastName            String
  birthDate           DateTime
  email               String
  phone               String
  targetCourse        String
  previousInstitution String?
  previousCourse      String?
  status              ApplicationStatus @default(DRAFT)
  registerId          Int
  register            AdmissionRegister @relation(fields: [registerId], references: [id])
  enrolledStudentId   Int?
  createdAt           DateTime          @default(now())
}
