generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  grade           String
  intakeBatchId   Int?
  intakeBatch     IntakeBatch?     @relation(fields: [intakeBatchId], references: [id])
  studentFees     StudentFee[]
  attendanceLines AttendanceLine[]
  examResults     ExamResult[]
  assignmentSubmissions AssignmentSubmission[]
  bookBorrows     BookBorrow[]
  createdAt       DateTime         @default(now())
}

model Course {
  id               Int               @id @default(autoincrement())
  title            String
  code             String            @unique
  instructor       String
  batches          IntakeBatch[]
  subjects         Subject[]
  sessions         Session[]
  attendanceSheets AttendanceSheet[]
  examSchedules    ExamSchedule[]
  assignments      Assignment[]
  createdAt        DateTime          @default(now())
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String
  code      String     @unique
  faculties Faculty[]
  subjects  Subject[]
  employees Employee[]
  createdAt DateTime   @default(now())
}

model Faculty {
  id               Int               @id @default(autoincrement())
  firstName        String
  lastName         String
  email            String            @unique
  departmentId     Int
  department       Department        @relation(fields: [departmentId], references: [id])
  sessions         Session[]
  attendanceSheets AttendanceSheet[]
  assignments      Assignment[]
  createdAt        DateTime          @default(now())
}

model IntakeBatch {
  id               Int               @id @default(autoincrement())
  code             String            @unique
  name             String
  startDate        DateTime
  endDate          DateTime
  courseId         Int
  course           Course            @relation(fields: [courseId], references: [id])
  active           Boolean           @default(true)
  students         Student[]
  sessions         Session[]
  attendanceSheets AttendanceSheet[]
  examSchedules    ExamSchedule[]
  assignments      Assignment[]
  createdAt        DateTime          @default(now())
}

model Subject {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  weightage     Float          @default(1.0)
  type          String         @default("Theory")
  courseId      Int
  course        Course         @relation(fields: [courseId], references: [id])
  departmentId  Int?
  department    Department?    @relation(fields: [departmentId], references: [id])
  sessions      Session[]
  examSchedules ExamSchedule[]
  assignments   Assignment[]
  createdAt     DateTime       @default(now())
}

model Classroom {
  id          Int       @id @default(autoincrement())
  name        String
  code        String    @unique
  capacity    Int       @default(30)
  building    String?
  facilities  String?
  sessions    Session[]
  createdAt   DateTime  @default(now())
}

model Period {
  id            Int      @id @default(autoincrement())
  name          String
  startTime     String
  endTime       String
  durationHours Float    @default(1.0)
  sequence      Int      @default(1)
  createdAt     DateTime @default(now())
}

// --- ADMISSIONS MODULE ---

enum RegisterStatus {
  DRAFT
  CONFIRMED
  GATHERING
  PROCESSING
  DONE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  ADMISSION_CONFIRM
  DONE
  REJECTED
  CANCELLED
}

model AdmissionRegister {
  id           Int              @id @default(autoincrement())
  name         String
  startDate    DateTime
  endDate      DateTime
  minCapacity  Int              @default(0)
  maxCapacity  Int
  targetCourse String
  status       RegisterStatus   @default(DRAFT)
  applications Application[]
  createdAt    DateTime         @default(now())
}

model Application {
  id                  Int               @id @default(autoincrement())
  applicationNumber   String            @unique
  firstName           String
  middleName          String?
  lastName            String
  birthDate           DateTime
  email               String
  phone               String
  targetCourse        String
  previousInstitution String?
  previousCourse      String?
  status              ApplicationStatus @default(DRAFT)
  registerId          Int
  register            AdmissionRegister @relation(fields: [registerId], references: [id])
  enrolledStudentId   Int?
  createdAt           DateTime          @default(now())
}

// --- FINANCE & FEES MODULE ---

enum FeeStatus {
  DRAFT
  INVOICE_CREATED
  PAID
  CANCELLED
}

model FeeTerm {
  id           Int              @id @default(autoincrement())
  name         String
  code         String           @unique
  description  String?
  totalAmount  Float
  installments FeeInstallment[]
  studentFees  StudentFee[]
  createdAt    DateTime         @default(now())
}

model FeeInstallment {
  id         Int      @id @default(autoincrement())
  name       String
  percentage Float
  dueDays    Int      @default(30)
  feeTermId  Int
  feeTerm    FeeTerm  @relation(fields: [feeTermId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model StudentFee {
  id            Int        @id @default(autoincrement())
  invoiceNumber String     @unique
  studentId     Int
  student       Student    @relation(fields: [studentId], references: [id])
  feeTermId     Int
  feeTerm       FeeTerm    @relation(fields: [feeTermId], references: [id])
  grossAmount   Float
  discount      Float      @default(0)
  netAmount     Float
  paidAmount    Float      @default(0)
  dueDate       DateTime
  status        FeeStatus  @default(DRAFT)
  createdAt     DateTime   @default(now())
}

// --- TIMETABLES & SESSIONS MODULE ---

enum SessionStatus {
  DRAFT
  CONFIRMED
  DONE
  CANCELLED
}

model Session {
  id               Int               @id @default(autoincrement())
  title            String
  courseId         Int
  course           Course            @relation(fields: [courseId], references: [id])
  batchId          Int
  batch            IntakeBatch       @relation(fields: [batchId], references: [id])
  subjectId        Int
  subject          Subject           @relation(fields: [subjectId], references: [id])
  facultyId        Int
  faculty          Faculty           @relation(fields: [facultyId], references: [id])
  classroomId      Int
  classroom        Classroom         @relation(fields: [classroomId], references: [id])
  startDatetime    DateTime
  endDatetime      DateTime
  status           SessionStatus     @default(DRAFT)
  attendanceSheets AttendanceSheet[]
  createdAt        DateTime          @default(now())
}

// --- DAILY ATTENDANCE MODULE ---

enum SheetStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT_EXCUSED
  ABSENT_UNEXCUSED
  LATE
}

model AttendanceSheet {
  id        Int              @id @default(autoincrement())
  sheetCode String           @unique
  date      DateTime
  courseId  Int
  course    Course           @relation(fields: [courseId], references: [id])
  batchId   Int
  batch     IntakeBatch      @relation(fields: [batchId], references: [id])
  sessionId Int?
  session   Session?         @relation(fields: [sessionId], references: [id])
  facultyId Int
  faculty   Faculty          @relation(fields: [facultyId], references: [id])
  status    SheetStatus      @default(DRAFT)
  lines     AttendanceLine[]
  createdAt DateTime         @default(now())
}

model AttendanceLine {
  id        Int              @id @default(autoincrement())
  sheetId   Int
  sheet     AttendanceSheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student          @relation(fields: [studentId], references: [id])
  status    AttendanceStatus @default(PRESENT)
  remark    String?
  createdAt DateTime         @default(now())
}

// --- EXAMS & GRADES MODULE ---

enum ExamStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ExamType {
  MIDTERM
  FINAL
  QUIZ
  ASSIGNMENT
  PRACTICAL
}

model ExamSchedule {
  id        Int          @id @default(autoincrement())
  code      String       @unique
  title     String
  type      ExamType     @default(FINAL)
  courseId  Int
  course    Course       @relation(fields: [courseId], references: [id])
  batchId   Int
  batch     IntakeBatch  @relation(fields: [batchId], references: [id])
  subjectId Int
  subject   Subject      @relation(fields: [subjectId], references: [id])
  maxMarks  Float        @default(100.0)
  passMarks Float        @default(40.0)
  date      DateTime
  startTime String
  endTime   String
  venue     String?
  status    ExamStatus   @default(SCHEDULED)
  results   ExamResult[]
  createdAt DateTime     @default(now())
}

model ExamResult {
  id             Int          @id @default(autoincrement())
  examScheduleId Int
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id])
  marksObtained  Float
  grade          String?
  remarks        String?
  createdAt      DateTime     @default(now())
}

// --- ASSIGNMENTS MODULE ---

model Assignment {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  dueDate     DateTime
  maxMarks    Float     @default(100.0)
  courseId    Int
  course      Course    @relation(fields: [courseId], references: [id])
  batchId     Int
  batch       IntakeBatch @relation(fields: [batchId], references: [id])
  subjectId   Int
  subject     Subject   @relation(fields: [subjectId], references: [id])
  facultyId   Int
  faculty     Faculty   @relation(fields: [facultyId], references: [id])
  status      String    @default("ACTIVE") // ACTIVE, CLOSED
  submissions AssignmentSubmission[]
  createdAt   DateTime  @default(now())
}

model AssignmentSubmission {
  id            Int        @id @default(autoincrement())
  assignmentId  Int
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     Int
  student       Student    @relation(fields: [studentId], references: [id])
  content       String?    
  fileUrl       String?    
  submittedAt   DateTime   @default(now())
  marksObtained Float?
  remarks       String?
  status        String     @default("SUBMITTED") // SUBMITTED, GRADED, LATE
}

// --- LIBRARY MODULE ---

model Book {
  id              Int          @id @default(autoincrement())
  isbn            String       @unique
  title           String
  author          String
  publisher       String?
  category        String       @default("General")
  copies          Int          @default(1)
  availableCopies Int          @default(1)
  location        String?      // e.g. Shelf A-3
  createdAt       DateTime     @default(now())
  borrows         BookBorrow[]
}

model BookBorrow {
  id          Int       @id @default(autoincrement())
  bookId      Int
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  studentId   Int
  student     Student   @relation(fields: [studentId], references: [id])
  issuedAt    DateTime  @default(now())
  dueDate     DateTime
  returnedAt  DateTime?
  status      String    @default("ISSUED") // ISSUED, RETURNED, OVERDUE
  fineAmount  Float     @default(0.0)
  remarks     String?
}

// --- HR MODULE ---

model Employee {
  id             Int            @id @default(autoincrement())
  firstName      String
  lastName       String
  email          String         @unique
  phone          String?
  role           String         // e.g. Accountant, Admin Clerk, Security, Janitor
  employeeType   String         @default("NON_TEACHING") // TEACHING, NON_TEACHING
  departmentId   Int?
  department     Department?    @relation(fields: [departmentId], references: [id])
  salary         Float          @default(0.0)
  joinDate       DateTime       @default(now())
  status         String         @default("ACTIVE") // ACTIVE, INACTIVE, TERMINATED
  leaveRequests  LeaveRequest[]
  createdAt      DateTime       @default(now())
}

model LeaveRequest {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    String    @default("ANNUAL") // SICK, ANNUAL, UNPAID, MATERNITY, PATERNITY
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
}

