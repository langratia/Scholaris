generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id            Int              @id @default(autoincrement())
  name          String
  email         String           @unique
  grade         String
  intakeBatchId Int?
  intakeBatch   IntakeBatch?     @relation(fields: [intakeBatchId], references: [id])
  studentFees   StudentFee[]
  attendanceLines AttendanceLine[]
  createdAt     DateTime         @default(now())
}

model Course {
  id               Int               @id @default(autoincrement())
  title            String
  code             String            @unique
  instructor       String
  batches          IntakeBatch[]
  subjects         Subject[]
  sessions         Session[]
  attendanceSheets AttendanceSheet[]
  createdAt        DateTime          @default(now())
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String
  code      String    @unique
  faculties Faculty[]
  subjects  Subject[]
  createdAt DateTime  @default(now())
}

model Faculty {
  id               Int               @id @default(autoincrement())
  firstName        String
  lastName         String
  email            String            @unique
  departmentId     Int
  department       Department        @relation(fields: [departmentId], references: [id])
  sessions         Session[]
  attendanceSheets AttendanceSheet[]
  createdAt        DateTime          @default(now())
}

model IntakeBatch {
  id               Int               @id @default(autoincrement())
  code             String            @unique
  name             String
  startDate        DateTime
  endDate          DateTime
  courseId         Int
  course           Course            @relation(fields: [courseId], references: [id])
  active           Boolean           @default(true)
  students         Student[]
  sessions         Session[]
  attendanceSheets AttendanceSheet[]
  createdAt        DateTime          @default(now())
}

model Subject {
  id           Int       @id @default(autoincrement())
  name         String
  code         String    @unique
  weightage    Float     @default(1.0)
  type         String    @default("Theory")
  courseId     Int
  course       Course    @relation(fields: [courseId], references: [id])
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

model Classroom {
  id          Int       @id @default(autoincrement())
  name        String
  code        String    @unique
  capacity    Int       @default(30)
  building    String?
  facilities  String?
  sessions    Session[]
  createdAt   DateTime  @default(now())
}

model Period {
  id            Int      @id @default(autoincrement())
  name          String
  startTime     String
  endTime       String
  durationHours Float    @default(1.0)
  sequence      Int      @default(1)
  createdAt     DateTime @default(now())
}

// --- ADMISSIONS MODULE ---

enum RegisterStatus {
  DRAFT
  CONFIRMED
  GATHERING
  PROCESSING
  DONE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  ADMISSION_CONFIRM
  DONE
  REJECTED
  CANCELLED
}

model AdmissionRegister {
  id           Int              @id @default(autoincrement())
  name         String
  startDate    DateTime
  endDate      DateTime
  minCapacity  Int              @default(0)
  maxCapacity  Int
  targetCourse String
  status       RegisterStatus   @default(DRAFT)
  applications Application[]
  createdAt    DateTime         @default(now())
}

model Application {
  id                  Int               @id @default(autoincrement())
  applicationNumber   String            @unique
  firstName           String
  middleName          String?
  lastName            String
  birthDate           DateTime
  email               String
  phone               String
  targetCourse        String
  previousInstitution String?
  previousCourse      String?
  status              ApplicationStatus @default(DRAFT)
  registerId          Int
  register            AdmissionRegister @relation(fields: [registerId], references: [id])
  enrolledStudentId   Int?
  createdAt           DateTime          @default(now())
}

// --- FINANCE & FEES MODULE ---

enum FeeStatus {
  DRAFT
  INVOICE_CREATED
  PAID
  CANCELLED
}

model FeeTerm {
  id           Int              @id @default(autoincrement())
  name         String
  code         String           @unique
  description  String?
  totalAmount  Float
  installments FeeInstallment[]
  studentFees  StudentFee[]
  createdAt    DateTime         @default(now())
}

model FeeInstallment {
  id         Int      @id @default(autoincrement())
  name       String
  percentage Float
  dueDays    Int      @default(30)
  feeTermId  Int
  feeTerm    FeeTerm  @relation(fields: [feeTermId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model StudentFee {
  id            Int        @id @default(autoincrement())
  invoiceNumber String     @unique
  studentId     Int
  student       Student    @relation(fields: [studentId], references: [id])
  feeTermId     Int
  feeTerm       FeeTerm    @relation(fields: [feeTermId], references: [id])
  grossAmount   Float
  discount      Float      @default(0)
  netAmount     Float
  paidAmount    Float      @default(0)
  dueDate       DateTime
  status        FeeStatus  @default(DRAFT)
  createdAt     DateTime   @default(now())
}

// --- TIMETABLES & SESSIONS MODULE ---

enum SessionStatus {
  DRAFT
  CONFIRMED
  DONE
  CANCELLED
}

model Session {
  id               Int               @id @default(autoincrement())
  title            String
  courseId         Int
  course           Course            @relation(fields: [courseId], references: [id])
  batchId          Int
  batch            IntakeBatch       @relation(fields: [batchId], references: [id])
  subjectId        Int
  subject          Subject           @relation(fields: [subjectId], references: [id])
  facultyId        Int
  faculty          Faculty           @relation(fields: [facultyId], references: [id])
  classroomId      Int
  classroom        Classroom         @relation(fields: [classroomId], references: [id])
  startDatetime    DateTime
  endDatetime      DateTime
  status           SessionStatus     @default(DRAFT)
  attendanceSheets AttendanceSheet[]
  createdAt        DateTime          @default(now())
}

// --- DAILY ATTENDANCE MODULE ---

enum SheetStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT_EXCUSED
  ABSENT_UNEXCUSED
  LATE
}

model AttendanceSheet {
  id        Int              @id @default(autoincrement())
  sheetCode String           @unique
  date      DateTime
  courseId  Int
  course    Course           @relation(fields: [courseId], references: [id])
  batchId   Int
  batch     IntakeBatch      @relation(fields: [batchId], references: [id])
  sessionId Int?
  session   Session?         @relation(fields: [sessionId], references: [id])
  facultyId Int
  faculty   Faculty          @relation(fields: [facultyId], references: [id])
  status    SheetStatus      @default(DRAFT)
  lines     AttendanceLine[]
  createdAt DateTime         @default(now())
}

model AttendanceLine {
  id        Int              @id @default(autoincrement())
  sheetId   Int
  sheet     AttendanceSheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student          @relation(fields: [studentId], references: [id])
  status    AttendanceStatus @default(PRESENT)
  remark    String?
  createdAt DateTime         @default(now())
}
