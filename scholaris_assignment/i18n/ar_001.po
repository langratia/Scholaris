"                                            </table>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                                <tr>\n"
"                                                    <td valign=\"top\" style=\"font-size: 13px;\">\n"
"                                                        <p>Dear</p>\n"
"                                                        <strong>\n"
"                                                            <t t-out=\"object.student_id.name or ''\"/>\n"
"                                                        </strong>\n"
"                                                        <p>Your Assignment Submission\n"
"                                                            <strong>\n"
"                                                                <t t-out=\"object.assignment_id.name or ''\"/>\n"
"                                                            </strong>\n"
"                                                            date\n"
"                                                            <strong>(\n"
"                                                                <t t-out=\"object.submission_date or ''\"/>)\n"
"                                                            </strong>\n"
"                                                            has\n"
"                                                            been passed. Please submit it as soon as possible.\n"
"                                                        </p>\n"
"                                                        <p>Thank you.</p>\n"
"                                                    </td>\n"
"                                                </tr>\n"
"                                                <tr>\n"
"                                                    <td style=\"text-align:center;\">\n"
"                                                        <hr width=\"100%\" style=\"background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;\"/>\n"
"                                                    </td>\n"
"                                                </tr>\n"
"                                            </table>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                                <tr>\n"
"                                                    <td valign=\"middle\" align=\"left\">\n"
"                                                        <t t-out=\"object.company_id.name or ''\"/>\n"
"                                                    </td>\n"
"                                                </tr>\n"
"                                                <tr>\n"
"                                                    <td valign=\"middle\" align=\"left\" style=\"opacity: 0.7;\">\n"
"                                                        <t t-out=\"object.company_id.phone or ''\"/>\n"
"                                                        <t t-if=\"object.company_id.email\">\n"
"                                                            |\n"
"                                                            <a href=\"'mailto:%s'%20%20%7B%7B%20object.company_id.email%20%7D%7D\" style=\"text-decoration:none; color: #454748;\">\n"
"                                                                <t t-out=\"object.company_id.email or ''\"/>\n"
"                                                            </a>\n"
"                                                        </t>\n"
"                                                        <t t-if=\"object.company_id.website\">\n"
"                                                            |\n"
"                                                            <a href=\"'%s'%20%20%7B%7B%20object.company_id.website%20%7D%7D\" style=\"text-decoration:none; color: #454748;\">\n"
"                                                                <t t-out=\"object.company_id.website or ''\"/>\n"
"                                                            </a>\n"
"                                                        </t>\n"
"                                                    </td>\n"
"                                                </tr>\n"
"                                            </table>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </tbody>\n"
"                            </table>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"            "
